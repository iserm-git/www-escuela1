            Grupos[👥 /grupos<br/>Lista + CRUD]
        end
        
        Reportes[📊 /reportes<br/>Reportes y Estadísticas]
        Gestion[⚙️ /gestion<br/>Gestión Escolar]
    end
    
    subgraph Components["🧩 COMPONENTES REUTILIZABLES"]
        direction LR
        
        subgraph Dialogs["💬 Diálogos"]
            AlumnoDialog[AlumnoDialog<br/>Crear/Editar]
            ProfesorDialog[ProfesorDialog<br/>Crear/Editar]
            MateriaDialog[MateriaDialog<br/>Crear/Editar]
            GrupoDialog[GrupoDialog<br/>Crear/Editar]
        end
        
        subgraph DetailDialogs["👁️ Vistas Detalle"]
            AlumnoDetailDialog[AlumnoDetailDialog<br/>Vista completa]
            ProfesorDetailDialog[ProfesorDetailDialog<br/>Vista completa]
            MateriaDetailDialog[MateriaDetailDialog<br/>Vista completa]
            GrupoDetailDialog[GrupoDetailDialog<br/>Vista completa]
        end
        
        Protected[🔒 Protected<br/>Auth Wrapper]
    end
    
    subgraph Features["⚙️ FUNCIONALIDADES"]
        direction TB
        
        Tables[📋 Tablas MUI<br/>- Paginación<br/>- Búsqueda<br/>- Ordenamiento]
        
        Forms[📝 Formularios<br/>- Validación<br/>- Estados<br/>- CRUD Operations]
        
        Search[🔍 Búsqueda<br/>- Filtrado en tiempo real<br/>- Multi-campo]
        
        Actions[⚡ Acciones<br/>- Crear ➕<br/>- Editar ✏️<br/>- Eliminar 🗑️<br/>- Ver 👁️]
    end
    
    subgraph Libraries["📦 LIBRERÍAS PRINCIPALES"]
        MUI[Material-UI<br/>- Components<br/>- Icons<br/>- Charts<br/>- DataGrid]
        
        NextJS[Next.js 15<br/>- App Router<br/>- Server Components<br/>- Client Components]
        
        React[React 19<br/>- Hooks<br/>- useState<br/>- useEffect]
        
        DateFns[date-fns<br/>Manejo de fechas]
        
        Axios[axios<br/>HTTP Cliente]
    end
    
    subgraph DataFlow["📊 FLUJO DE DATOS"]
        direction TB
        MockData[(Datos Mock<br/>INITIAL_DATA)]
        State[useState<br/>Local State]
        Filter[Filtrado<br/>filteredRows]
        Display[Renderizado<br/>visibleRows]
        
        MockData --> State
        State --> Filter
        Filter --> Display
    end
    
    %% Conexiones principales
    Layout --> Providers
    Providers --> Chrome
    Chrome -.->|Conditional| Navbar
    Chrome --> Pages
    Chrome -.->|Conditional| Footer
    
    Pages --> Protected
    Protected -.->|Auth Check| CRUD
    
    Alumnos --> AlumnoDialog
    Alumnos --> AlumnoDetailDialog
    Profesores --> ProfesorDialog
    Profesores --> ProfesorDetailDialog
    Materias --> MateriaDialog
    Materias --> MateriaDetailDialog
    Grupos --> GrupoDialog
    Grupos --> GrupoDetailDialog
    
    CRUD --> Tables
    CRUD --> Forms
    CRUD --> Search
    CRUD --> Actions
    
    Pages --> DataFlow
    Components --> MUI
    Pages --> NextJS
    Components --> React
    
